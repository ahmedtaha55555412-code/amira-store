# Amira Store — Environment Variable Contract (names only; NEVER commit real values)
# Local values live in .env (git-ignored). Preview/Production values are configured
# in the respective platform secret/environment stores (GitHub Actions secrets, Vercel env).
# Reference: docs/ops/DEPLOYMENT_RUNBOOK.md, docs/ops/DATABASE.md

# --- Database (PostgreSQL / Neon — the ONLY application data layer since PHASE_02) ---
# Local development: any disposable PostgreSQL (or a Neon dev branch string).
# Preview/Production: injected automatically by the Vercel ↔ Neon integration
# (project `amira-store`, 18 DATABASE_* vars across all three environments).
# App runtime should use the Neon POOLED endpoint; migrations use the direct endpoint.
DATABASE_URL=
# Required before running any remote stateful verify-* script. Comma-separated exact
# Production endpoint hostnames (direct and pooled) plus database name; metadata only.
PRODUCTION_DATABASE_HOSTS=
PRODUCTION_DATABASE_NAME=

# --- Auth / session (consumed since PHASE-03; strong random secret, per-environment) ---
# Used for client-IP hashing in audit rows (AUTH_SESSION_SECRET never reaches clients).
AUTH_SESSION_SECRET=

# --- First-admin bootstrap CLI (scripts/db-bootstrap-admin.ts; PHASE-03) ---
# Names only — set real values in .env.local (git-ignored) for a one-time run.
# Refuses to run when an admin already exists; the password is never printed.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Application URL ---
# Local: http://localhost:3000 | Preview: Vercel preview URL | Production: store domain
APP_URL=

# --- Media storage (Vercel Blob, introduced in Phase 04 via media service abstraction) ---
# Two supported auth surfaces (Vercel's current model, verified 2026-09-27):
# 1. OIDC (default for newly connected stores): when the store is connected to the
#    project, Vercel injects BLOB_STORE_ID + VERCEL_OIDC_TOKEN automatically — only
#    valid inside the Vercel runtime (the OIDC token is minted/rotated there).
# 2. Legacy long-lived token for stores not yet upgraded to OIDC:
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=          # OIDC path (injected by Vercel on connect; set locally only for advanced use)
# VERCEL_OIDC_TOKEN=      # OIDC path (runtime-minted; never commit a value)
