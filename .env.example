# Amira Store — Environment Variable Contract (names only; NEVER commit real values)
# Local values live in .env (git-ignored). Preview/Production values are configured
# in the respective platform secret/environment stores (GitHub Actions secrets, Vercel env).
# Reference: docs/ops/DEPLOYMENT_RUNBOOK.md

# --- Database (Neon PostgreSQL in Preview/Production per MASTER_PLAN §25/§27) ---
# Local development currently uses the sandbox SQLite dev database; Phase 02 introduces
# Drizzle ORM + PostgreSQL migration tooling against Neon once provisioning completes.
DATABASE_URL=

# --- Auth / session (Phase 03 consumes this; strong random secret, per-environment) ---
AUTH_SESSION_SECRET=

# --- Application URL ---
# Local: http://localhost:3000 | Preview: Vercel preview URL | Production: store domain
APP_URL=

# --- Media storage (Vercel Blob, introduced in Phase 04 via media service abstraction) ---
BLOB_READ_WRITE_TOKEN=
